# ── Kraken API ────────────────────────────────────────────────────────────────
# Create at: https://www.kraken.com/u/security/api
# Required permissions: Query Funds, Create & Modify Orders, Cancel & Close Orders
# DO NOT grant Withdraw permissions.
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token below
# 2. Message @userinfobot on Telegram → copy your numeric chat ID below
TELEGRAM_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=987654321

# ── Groq AI (valuta e approva/rifiuta ogni segnale) ──────────────────────────
# Crea la chiave gratis su: https://console.groq.com/keys
# Modello consigliato: llama3-8b-8192 (veloce, gratuito)
# Alternativa più potente: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# ── Budget (optional — for reference only, actual balance read from Kraken) ───
BUDGET_EUR=100
