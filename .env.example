# ════════════════════════════════════════════════════════════════════
#  Kraken Trading Bot — configurazione completa
#  Copia in .env e compila i valori obbligatori (*)
# ════════════════════════════════════════════════════════════════════

# ── Deploy paths — NAS / server remoto (non committare) ──────────────
BOT_DIR=/volume1/homes/youruser/kraken-trading-bot
BOT_PYTHON=/volume1/homes/youruser/venv_trading/bin/python

# ── Kraken API (*) ────────────────────────────────────────────────────
# Crea le chiavi su: https://www.kraken.com/u/security/api
# Permessi richiesti: Query Funds, Create & Modify Orders, Cancel & Close Orders
# NON abilitare Withdraw.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Telegram Bot (*) ──────────────────────────────────────────────────
# 1. Messaggio @BotFather → /newbot → copia il token
# 2. Messaggio @userinfobot → copia il tuo chat ID numerico
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Groq AI (*) ───────────────────────────────────────────────────────
# Chiave gratuita: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
# Alternativa più potente (più lenta):
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Modalità operativa ────────────────────────────────────────────────
PAPER_TRADING=true          # true = nessun ordine reale su Kraken
TRADING_PROFILE=conservative  # conservative | moderate | aggressive

# ── Budget ────────────────────────────────────────────────────────────
BUDGET_EUR=100

# ── Pairs da monitorare (separati da virgola) ─────────────────────────
#PAIRS=DOGEEUR,XRPEUR,SOLEUR,ETHEUR,XBTEUR

# ── Position sizing ───────────────────────────────────────────────────
#MAX_OPEN_TRADES=4
#MAX_CAPITAL_DEPLOYED=0.80   # 80% del budget massimo impiegato
#MARGIN_LEVERAGE=2

# ── AI sizing (% del budget per segnale) ─────────────────────────────
#AI_SIZE_HIGH=0.25   # Groq score 9-10
#AI_SIZE_MED=0.18    # Groq score 8
#AI_SIZE_MIN=0.12    # Groq score 7
#GROQ_MIN_CONFIDENCE=6   # score minimo per eseguire (1-10)

# ── TP/SL (usati solo se ATR non disponibile) ─────────────────────────
#TAKE_PROFIT_PCT=0.10
#STOP_LOSS_PCT=0.04

# ── ATR-based TP/SL ───────────────────────────────────────────────────
#ATR_TP_MULT=2.5   # TP = entry + mult × ATR
#ATR_SL_MULT=1.0   # SL = entry − mult × ATR  →  R:R ≈ 2.5:1

# ── Trailing stop ─────────────────────────────────────────────────────
#TRAILING_STOP_ENABLED=true
#TRAILING_STOP_PCT=0.03   # 3% dal massimo raggiunto

# ── Limit orders ──────────────────────────────────────────────────────
#LIMIT_ORDERS_ENABLED=true
#LIMIT_OFFSET_PCT=0.001   # piazza limit 0.1% sotto il bid
#LIMIT_TIMEOUT_SEC=300    # converti in market dopo 5 minuti
#SLIPPAGE_PCT=0.001

# ── Circuit Breaker ───────────────────────────────────────────────────
#CIRCUIT_BREAKER_ENABLED=true
#CIRCUIT_BREAKER_LOSS_EUR=15   # blocca il bot se perdi più di X€ in un giorno

# ── Filtri segnale ────────────────────────────────────────────────────
#MIN_SIGNAL_SCORE=3         # punti minimi su 6 per generare un segnale
#VOLUME_SPIKE_MULT=1.15     # volume minimo rispetto alla media (1.15 = +15%)
#RSI_1H_BUY_MAX=65
#RSI_15M_BUY_MAX=62
#RSI_4H_BUY_MAX=70
#RSI_SHORT_MIN=35           # non shortare se RSI 1h è già sotto questa soglia
#ADX_MIN=20                 # forza minima del trend

# ── Filtro BTC ────────────────────────────────────────────────────────
#BTC_FILTER_ENABLED=true
#BTC_PAIR=XBTEUR
#BTC_RSI_MAX=65             # blocca long se BTC RSI supera questa soglia
#BTC_RSI_SHORT_MIN=28       # blocca short se BTC RSI è già troppo basso
#BTC_EMA_FILTER=true        # richiede BTC sopra EMA50 per aprire long

# ── Fear & Greed ──────────────────────────────────────────────────────
#FEAR_GREED_ENABLED=true
#FEAR_GREED_MIN=20   # blocca long sotto questo valore (extreme fear)
#FEAR_GREED_MAX=80   # blocca long sopra questo valore (extreme greed)

# ── EMA giornaliera ───────────────────────────────────────────────────
#DAILY_EMA_FILTER=true   # richiede prezzo sopra EMA50 daily per aprire long

# ── Dati esterni ──────────────────────────────────────────────────────
#NEWS_ENABLED=true
#NEWS_HEADLINES=4
#ONCHAIN_ENABLED=true

# ── Kelly Criterion ───────────────────────────────────────────────────
#KELLY_ENABLED=true
#KELLY_MIN_TRADES=50      # trade minimi prima di attivare Kelly
#KELLY_FRACTION=0.25      # quarter-Kelly (conservativo)
#KELLY_MIN_SIZE_PCT=0.10
#KELLY_MAX_SIZE_PCT=0.25

# ── Timing ────────────────────────────────────────────────────────────
#SCAN_INTERVAL_MINUTES=15    # ogni quanti minuti scansiona le coppie
#POSITION_CHECK_SECONDS=60   # ogni quanti secondi controlla TP/SL/trailing
#DAILY_REPORT_HOUR=8         # ora del report giornaliero (0-23)
